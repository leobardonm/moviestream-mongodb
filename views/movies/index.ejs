<div class="page-header">
  <div>
    <span class="page-title-count"><%= totalCount %> películas<% if (search || selectedGenre) { %> encontradas<% } %></span>
    <h1 class="page-title">Catálogo</h1>
  </div>
  <a href="/movies/new" class="btn btn-primary">+ Nueva película</a>
</div>

<form class="toolbar" method="GET" action="/movies">
  <div class="search-wrap">
    <span class="search-icon">⌕</span>
    <input class="input-search" type="text" name="search" placeholder="Buscar título..." value="<%= search %>">
  </div>
  <select class="filter-select" name="genre" onchange="this.form.submit()">
    <option value="">Todos los géneros</option>
    <% genres.forEach(g => { %>
      <option value="<%= g.name %>" <%= selectedGenre === g.name ? 'selected' : '' %>><%= g.name %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-ghost">Buscar</button>
  <% if (search || selectedGenre) { %>
    <a href="/movies" class="btn btn-ghost">× Limpiar</a>
  <% } %>
</form>

<div class="grid">
  <% movies.forEach(movie => { %>
    <div class="card">
      <a class="card-poster" href="/movies/<%= movie._id %>">
        <% if (movie.image_url) { %>
          <img src="<%= movie.image_url %>" alt="<%= movie.title %>" loading="lazy"
               onerror="this.parentElement.innerHTML='<div class=\'card-poster-placeholder\'>◈</div>'">
        <% } else { %>
          <div class="card-poster-placeholder">◈</div>
        <% } %>
        <div class="card-overlay">
          <div class="card-overlay-genres">
            <% (movie.genres || []).slice(0,2).forEach(g => { %>
              <span class="card-overlay-genre"><%= g.name %></span>
            <% }) %>
          </div>
        </div>
      </a>
      <div class="card-body">
        <div class="card-title"><%= movie.title %></div>
        <div class="card-meta"><%= movie.year || '—' %> · $<%= (movie.list_price || 0).toFixed(2) %></div>
        <div class="card-actions">
          <a href="/movies/<%= movie._id %>/edit" class="btn btn-ghost btn-sm">Editar</a>
          <form action="/movies/<%= movie._id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar?')" style="display:inline">
            <button type="submit" class="btn btn-danger btn-sm">×</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!movies.length) { %>
    <div class="empty-state">
      <span class="empty-state-icon">◈</span>
      No se encontraron películas
    </div>
  <% } %>
</div>

<% if (movies.length === 200) { %>
  <p class="limit-notice">Mostrando 200 resultados — usa el buscador para filtrar</p>
<% } %>
